# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored — never commit real keys.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Verified sender address/domain in Resend. Use "Name <email>" or just an email.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Inbox that receives messages sent from the contact form.
CONTACT_TO_EMAIL=ekanshsaraswat1234@gmail.com

# Optional: port for the local Express server (defaults to 5000)
PORT=5000
